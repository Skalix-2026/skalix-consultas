# ==== Skalix Consultas - variaveis de ambiente (NUNCA versionar este arquivo) ====

# --- WhatsApp Business Platform (Meta) ---
# ID do app Meta: developers.facebook.com > Meus apps > seu app > Configurações > Básico
META_APP_ID=
# ID da conta do WhatsApp Business (WABA): business.facebook.com > WhatsApp Manager > Contas / Configurações
WHATSAPP_WABA_ID=
# ID do número de telefone: developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
# Cole abaixo o token permanente do usuario do sistema "Sistema-consultas"
WHATSAPP_TOKEN=
# Palavra secreta que voce inventa; a Meta pede ao validar o webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Em Configuracoes do app > Basico > "Chave secreta do app" (valida assinatura do webhook)
META_APP_SECRET=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Banco (Supabase/Postgres) - preencher na Fase 0 ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observabilidade (Langfuse) - opcional no inicio ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Painel (senha unica ate a Fase 3; Supabase Auth substitui depois) ---
# OBRIGATORIA em producao, com NO MINIMO 16 caracteres: ausente ou mais curta, o painel
# responde 503 em tudo (falha fechada, nunca libera).
# Em dev, se vazia, o painel fica aberto. Use uma senha longa e aleatoria.
# Trocar a senha derruba todas as sessoes abertas (cookie painel_sessao, 12h).
PAINEL_SENHA=

# --- Inngest (filas) ---
# OBRIGATORIA em producao: sem INNGEST_SIGNING_KEY a rota /api/inngest responde 503.
# Em dev local (INNGEST_DEV=1 / npm run inngest:dev) pode ficar vazia.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
